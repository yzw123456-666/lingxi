<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LingXiApp</AssemblyName>
    <RootNamespace>LingXiApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>灵犀压缩盒</AssemblyTitle>
    <Product>灵犀压缩盒 (LingXi Box)</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.html" />
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="lingxi_engine.dll" />
  </ItemGroup>
</Project>
